{
  "name": "@umami/api-client",
  "version": "3.3.0",
  "description": "API client for Umami Analytics",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umami-software/api-client.git"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm build",
    "test": "jest",
    "test:live": "jest test/live.test.js",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "dependencies": {
    "debug": "^4.3.4",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/debug": "^4.1.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^18.7.13",
    "dotenv": "^10.0.0",
    "jest": "^30.4.2",
    "rollup": "^2.78.1",
    "rollup-plugin-ts": "^3.0.2",
    "tslib": "^2.4.1",
    "typescript": "^4.7.4"
  }
}
