# Self-hosted umami: mint tokens with the server's APP_SECRET
UMAMI_API_CLIENT_USER_ID=
UMAMI_API_CLIENT_SECRET=
UMAMI_API_CLIENT_ENDPOINT=http://localhost:3000/api

# Umami Cloud: use an API key instead
# UMAMI_API_CLIENT_ENDPOINT=https://api.umami.is/v1
UMAMI_API_KEY=

# Used by the live test suite
UMAMI_WEBSITE_ID=
